rules_version = '2';
// Piloto de migração Sheets -> Firestore (login + clientes + vendas + funil).
// Exige estar autenticado (Firebase Auth) pra ler/escrever essas 4 coleções.
// Não distingue papel (admin/vendedor) ainda por dentro da regra — isso é
// suficiente pra ESSE piloto (só existe 1 usuário de teste, admin); quando a
// migração virar de verdade, entra checagem por papel aqui (ver
// segundo-cerebro/padroes/dados-e-seguranca.md).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    match /vendedores/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /clientes/{id} {
      allow read, write: if isSignedIn();
    }
    match /vendas/{id} {
      allow read, write: if isSignedIn();
    }
    match /funil/{id} {
      allow read, write: if isSignedIn();
    }
    match /servicos/{id} {
      allow read, write: if isSignedIn();
    }

    // ── App do técnico (piloto offline) ──
    match /agendamentos/{id} {
      allow read, write: if isSignedIn();
    }
    match /agendamentos_respostas/{id} {
      allow read, write: if isSignedIn();
    }
    match /templates/{id} {
      allow read, write: if isSignedIn();
    }
    match /produtos_modulos/{id} {
      allow read, write: if isSignedIn();
    }
    match /produtos_inversores/{id} {
      allow read, write: if isSignedIn();
    }

    // ── Custos da Venda / Relatórios / Planos / Custo Recorrente / Metas /
    // Permissões / Ponto — ligadas ao Firestore de verdade em 2026-08-24
    // (antes stub). Mesma regra "só exige estar logado" do resto do piloto.
    match /custos_venda/{id} {
      allow read, write: if isSignedIn();
    }
    match /relatorios/{id} {
      allow read, write: if isSignedIn();
    }
    match /planos/{id} {
      allow read, write: if isSignedIn();
    }
    match /custo_recorrente/{id} {
      allow read, write: if isSignedIn();
    }
    match /metas/{id} {
      allow read, write: if isSignedIn();
    }
    match /metas_individuais/{id} {
      allow read, write: if isSignedIn();
    }
    match /permissoes/{id} {
      allow read, write: if isSignedIn();
    }
    match /ponto/{id} {
      allow read, write: if isSignedIn();
    }
    match /ponto_overrides/{id} {
      allow read, write: if isSignedIn();
    }

    // Tudo o que não faz parte desse piloto fica fechado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
