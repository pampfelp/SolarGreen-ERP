rules_version = '2';
// Piloto de migração Sheets -> Firestore (login + clientes + vendas + funil).
// Exige estar autenticado (Firebase Auth) pra ler/escrever essas 4 coleções.
// Não distingue papel (admin/vendedor) ainda por dentro da regra — isso é
// suficiente pra ESSE piloto (só existe 1 usuário de teste, admin); quando a
// migração virar de verdade, entra checagem por papel aqui (ver
// segundo-cerebro/padroes/dados-e-seguranca.md).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    // Administrador (2026-10-29, tela de campanhas): o doc vendedores/{uid} da
    // pessoa logada tem Tipo de chefia e Status Ativo. É a mesma lista de
    // papéis de SG_ADMIN_ROLES (js/sg-auth.js) e ADMIN_ROLES do Code.gs.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/vendedores/$(request.auth.uid))
        && get(/databases/$(database)/documents/vendedores/$(request.auth.uid)).data.Tipo.lower()
             in ['admin', 'administrador', 'ceo', 'gestor', 'gerente']
        && get(/databases/$(database)/documents/vendedores/$(request.auth.uid)).data.Status == 'Ativo';
    }

    match /vendedores/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /clientes/{id} {
      allow read, write: if isSignedIn();
    }
    match /vendas/{id} {
      allow read, write: if isSignedIn();
    }
    match /funil/{id} {
      allow read, write: if isSignedIn();
    }
    // Presença ao vivo (2026-08-25): 1 doc por lead sendo editado agora,
    // com timestamp — o cliente ignora docs "velhos" (heartbeat parado)
    // sozinho, então não precisa de TTL/limpeza no servidor pra isso não
    // ficar "preso" mostrando alguém editando pra sempre.
    match /funil_presenca/{id} {
      allow read, write: if isSignedIn();
    }
    // Configuração dos pipelines do Funil (Comercial/Administrativo/
    // Expansão/outros criados pelo Felipe) — 2026-08-31.
    match /funil_pipelines/{id} {
      allow read, write: if isSignedIn();
    }
    match /servicos/{id} {
      allow read, write: if isSignedIn();
    }

    // ── App do técnico (piloto offline) ──
    match /agendamentos/{id} {
      allow read, write: if isSignedIn();
    }
    match /agendamentos_respostas/{id} {
      allow read, write: if isSignedIn();
    }
    match /templates/{id} {
      allow read, write: if isSignedIn();
    }
    // Lista de material: mesmo login do ERP; fotos não são persistidas aqui.
    match /listas_material/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'clienteId', 'idAgendamento', 'medidas', 'itens', 'aviso',
          'leituraIA', 'autorUid', 'atualizadoEm'
        ])
        && request.resource.data.keys().hasAll([
          'clienteId', 'idAgendamento', 'medidas', 'itens',
          'autorUid', 'atualizadoEm'
        ])
        && request.resource.data.clienteId is string
        && request.resource.data.clienteId.size() > 0
        && request.resource.data.clienteId.size() <= 100
        && request.resource.data.idAgendamento is string
        && request.resource.data.idAgendamento.size() <= 100
        && request.resource.data.medidas is map
        && request.resource.data.medidas.keys().hasOnly([
          'modules', 'watts', 'inverter', 'floors', 'ac', 'dc', 'ground',
          'roof', 'connection', 'inverterOutput', 'sun', 'point', 'conduit',
          'acIn', 'acOut', 'acFlex', 'dcIn', 'dcOut', 'dcRoof'
        ])
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 150
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.atualizadoEm == request.time
        && (!('aviso' in request.resource.data) ||
          (request.resource.data.aviso is string && request.resource.data.aviso.size() <= 2000))
        && (!('leituraIA' in request.resource.data) ||
          (request.resource.data.leituraIA is string && request.resource.data.leituraIA.size() <= 2000))
        && exists(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId));
      allow delete: if false;
    }
    match /produtos_modulos/{id} {
      allow read, write: if isSignedIn();
    }
    match /produtos_inversores/{id} {
      allow read, write: if isSignedIn();
    }

    // ── Custos da Venda / Relatórios / Planos / Custo Recorrente / Metas /
    // Permissões / Ponto — ligadas ao Firestore de verdade em 2026-08-24
    // (antes stub). Mesma regra "só exige estar logado" do resto do piloto.
    match /custos_venda/{id} {
      allow read, write: if isSignedIn();
    }
    match /relatorios/{id} {
      allow read, write: if isSignedIn();
    }
    match /planos/{id} {
      allow read, write: if isSignedIn();
    }
    match /custo_recorrente/{id} {
      allow read, write: if isSignedIn();
    }
    match /metas/{id} {
      allow read, write: if isSignedIn();
    }
    match /metas_individuais/{id} {
      allow read, write: if isSignedIn();
    }
    match /permissoes/{id} {
      allow read, write: if isSignedIn();
    }
    // Ponto: batidas cruas, "append-only" pelo cliente. O app ponto.html
    // grava uma batida por vez, sempre da própria pessoa (Uid == quem está
    // logado). Correção de abono do admin não mexe aqui, vai em
    // ponto_overrides. A migração da planilha roda com Admin SDK (ignora
    // regra). Leitura continua "só logado" — a checagem por papel
    // (admin vê tudo, funcionário só o seu) é o próximo passo, junto com o
    // resto das regras (ver migrar-projeto-grande.md, checklist de cutover).
    match /ponto/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.Uid == request.auth.uid
        && request.resource.data.Funcionario is string
        && request.resource.data.Funcionario.size() > 0
        && request.resource.data.Tipo in ['Entrada', 'Almoço', 'Retorno Almoço', 'Saída']
        && request.resource.data['Foto Selfie'] is string
        && request.resource.data['Foto Selfie'].size() < 900000;
      allow update, delete: if false;
    }
    match /ponto_overrides/{id} {
      allow read, write: if isSignedIn();
    }
    // Gerador de Proposta (legado/proposta.html) — 2026-08-25, passou a ler
    // o Firestore de verdade em vez do Apps Script antigo (desativado).
    match /propostas/{id} {
      allow read, write: if isSignedIn();
    }

    // Flags de migração (2026-09-03) — hoje só config/migracao.criadoEmFunil,
    // ligado pelo backfill de _tools/backfill-criado-em.js pra o Funil poder
    // escutar só a janela recente de leads. Leitura pra qualquer logado;
    // escrita idem (o backfill roda com Admin SDK e ignora a regra de
    // qualquer jeito, mas deixar aberto evita erro se for setado pela tela).
    match /config/{id} {
      allow read, write: if isSignedIn();
    }

    // ── Site institucional (2026-09-29) ──
    // Antessala dos contatos do site: o público CRIA e nunca lê, atualiza nem
    // apaga. Quem lê e promove pra funil/clientes é o ERP logado
    // (js/leads-site-motor.js). Sem login anônimo de propósito: "estar
    // autenticado" continua significando "ser da equipe" (crença 12).
    // `hasOnly` fecha mass assignment; cada campo tem tipo e tamanho.
    function leadSiteValido(id){
      let d=request.resource.data;
      return d.keys().hasAll(['id','nome','whatsapp','whatsappFim8','servico','consentimento','origem','status','criadoEm'])
        && d.keys().hasOnly(['id','nome','whatsapp','whatsappFim8','cidade','servico','consentimento','consentimentoVersao',
             'origem','status','criadoEm','pagina','utmSource','utmMedium','utmCampaign','tempoPreenchimentoMs','suspeito',
             'calcPlacas','calcPotenciaW','calcKwp','calcCidade','calcForaDaLista','calcDesempenho','calcTarifa','calcPerdaAno'])
        && d.id==id
        && d.nome is string && d.nome.size()>=2 && d.nome.size()<=120
        && d.whatsapp is string && d.whatsapp.matches('^[0-9]{10,13}$')
        && d.whatsappFim8 is string && d.whatsappFim8.matches('^[0-9]{8}$')
        && d.whatsapp.matches('.*'+d.whatsappFim8)
        && d.servico is string && d.servico.size()>=1 && d.servico.size()<=60
        && d.consentimento==true
        && d.origem=='Site'
        && d.status=='novo'
        && d.criadoEm==request.time
        && (!('cidade' in d)||(d.cidade is string&&d.cidade.size()<=80))
        && (!('consentimentoVersao' in d)||(d.consentimentoVersao is string&&d.consentimentoVersao.size()<=20))
        && (!('pagina' in d)||(d.pagina is string&&d.pagina.size()<=200))
        && (!('utmSource' in d)||(d.utmSource is string&&d.utmSource.size()<=80))
        && (!('utmMedium' in d)||(d.utmMedium is string&&d.utmMedium.size()<=80))
        && (!('utmCampaign' in d)||(d.utmCampaign is string&&d.utmCampaign.size()<=120))
        && (!('tempoPreenchimentoMs' in d)||(d.tempoPreenchimentoMs is int&&d.tempoPreenchimentoMs>=0))
        && (!('suspeito' in d)||d.suspeito is bool)
        && (!('calcPlacas' in d)||(d.calcPlacas is int&&d.calcPlacas>=1&&d.calcPlacas<=10000))
        && (!('calcPotenciaW' in d)||(d.calcPotenciaW is number&&d.calcPotenciaW>=50&&d.calcPotenciaW<=2000))
        && (!('calcKwp' in d)||(d.calcKwp is number&&d.calcKwp>0&&d.calcKwp<=100000))
        && (!('calcCidade' in d)||(d.calcCidade is string&&d.calcCidade.size()<=80))
        && (!('calcForaDaLista' in d)||d.calcForaDaLista is bool)
        && (!('calcDesempenho' in d)||(d.calcDesempenho is number&&d.calcDesempenho>0&&d.calcDesempenho<=1.2))
        && (!('calcTarifa' in d)||(d.calcTarifa is number&&d.calcTarifa>0&&d.calcTarifa<=20))
        && (!('calcPerdaAno' in d)||(d.calcPerdaAno is number&&d.calcPerdaAno>=0&&d.calcPerdaAno<=100000000));
    }
    match /leads_site/{id} {
      allow create: if leadSiteValido(id);
      allow read, update: if isSignedIn();
      allow delete: if false;
    }
    // Único dado que o público lê: a tarifa de referência que a calculadora do
    // site usa. Fica numa coleção própria e NÃO em `config`, porque regras de
    // dois `match` sobre o mesmo documento se somam e `config` é de quem loga.
    match /config_publica/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Notificações de lead do site (2026-10-08, js/notificacoes.js).
    // Lidas: um documento por pessoa, mesma regra "só logado" do piloto.
    match /notificacoes_lidas/{id} {
      allow read, write: if isSignedIn();
    }
    // Endereço de push de cada aparelho. O navegador só grava e apaga o do
    // próprio aparelho; quem lê a lista é o Apps Script (conta de serviço,
    // fora destas regras), então ninguém logado consegue listar os aparelhos.
    match /push_tokens/{id} {
      allow read: if false;
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['token', 'idVendedor', 'aparelho', 'atualizadoEm'])
        && request.resource.data.token is string && request.resource.data.token.size() <= 4096
        && request.resource.data.idVendedor is string && request.resource.data.idVendedor.size() <= 100;
      allow delete: if isSignedIn();
    }

    // Disparo de reativação pela API do WhatsApp (2026-10-26). Quem manda e
    // atualiza o andamento é o Apps Script e o _tools/preparar-disparo.js, com
    // a conta de serviço (fora destas regras).
    // Tela de campanhas (2026-10-29, disparos.html): o administrador CRIA o
    // disparo do passo 1 (sempre em fila, só com os campos de criação) e só
    // mexe na marca de robô e na marca de remoção da campanha (removidoEm e
    // removidoPor, que também pode apagar ao devolver o contato) de um disparo
    // existente. Ninguém apaga.
    match /disparos/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'campanha', 'idOportunidade', 'idCliente', 'idVendedor', 'nomeVendedor', 'telVendedor',
          'nomeLead', 'nomeLeadCompleto', 'telLead', 'telFim8', 'segmento', 'modelo', 'referencia',
          'ordem', 'status', 'passo', 'criadoEm'
        ])
        && request.resource.data.keys().hasAll([
          'campanha', 'idOportunidade', 'idCliente', 'idVendedor', 'nomeVendedor', 'telVendedor',
          'nomeLead', 'nomeLeadCompleto', 'telLead', 'telFim8', 'segmento', 'modelo', 'referencia',
          'ordem', 'status', 'passo', 'criadoEm'
        ])
        && request.resource.data.status == 'fila'
        && request.resource.data.passo == 1
        && request.resource.data.campanha is string && request.resource.data.campanha.size() > 0
        && request.resource.data.telFim8 is string && request.resource.data.telFim8.matches('^[0-9]{8}$')
        && request.resource.data.telLead is string && request.resource.data.telLead.matches('^55[0-9]{10,11}$')
        && request.resource.data.modelo is string && request.resource.data.modelo.size() > 0
        && request.resource.data.ordem is number
        && request.resource.data.criadoEm is number
        && id == request.resource.data.campanha + '-' + (request.resource.data.idOportunidade != ''
             ? request.resource.data.idOportunidade : 'c' + request.resource.data.idCliente) + '-p1';
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['robo', 'roboDesmarcadoPor', 'roboDesmarcadoEm', 'removidoEm', 'removidoPor']);
      allow delete: if false;
    }
    match /interacoes_disparo/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    // Opt-out antigo (botão "Não quero receber"): a página só lê, pra deixar
    // esses contatos fora da seleção. Quem grava é o Apps Script.
    match /disparo_optout/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    // Campanhas (título, prazo, passos e modelos por tipo): só o admin escreve.
    match /campanhas/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // Conversas e modelos da Meta: só o Apps Script grava (conta de serviço).
    match /mensagens_disparo/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /modelos_disparo/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Tudo o que não faz parte desse piloto fica fechado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
